{
	"name": "pronamic/wp-orbis-timesheets",
	"description": "Time Management, Timesheet, Time Tracking solution for WordPress. Orbis Timesheets enables you to track your work time.",
	"license": "GPL-2.0-or-later",
	"type": "wordpress-plugin",
	"autoload": {
		"psr-4": {
			"Pronamic\\Orbis\\Timesheets\\": "classes/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"automattic/jetpack-autoloader": true
		},
		"wp-slug": "orbis-timesheets"
	},
	"require": {
		"automattic/jetpack-autoloader": "^3.0",
		"pronamic/wp-datetime": "^2.1"
	},
	"require-dev": {
		"pronamic/wp-coding-standards": "^2.1",
		"wp-cli/dist-archive-command": "*",
		"wp-cli/wp-cli-bundle": "*",
		"deployer/deployer": "^7.5"
	},
	"scripts": {
		"build": [
			"rm -rf ./build/stage-1",
			"rm -rf ./build/orbis-timesheets",
			"rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ ./ ./build/stage-1/",
			"composer install --no-dev --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/",
			"rsync --recursive --verbose --exclude-from=.distignore ./build/stage-1/ ./build/orbis-timesheets/",
			"vendor/bin/wp i18n make-pot ./build/orbis-timesheets/ --slug=orbis-timesheets",
			"vendor/bin/wp i18n make-mo ./build/orbis-timesheets/languages/",
			"vendor/bin/wp dist-archive ./build/orbis-timesheets/ --plugin-dirname=orbis-timesheets --force"
		],
		"dist-archive": "wp dist-archive . --plugin-dirname=orbis-timesheets",
		"make-pot": [
			"@build",
			"rsync --recursive --delete --verbose ./build/orbis-timesheets/languages/ ./languages/",
			"vendor/bin/wp i18n update-po ./languages/orbis-timesheets.pot"
		],
		"phpcs": "vendor/bin/phpcs",
		"qa": [
			"@phpcs"
		]
	}
}
